{
  "name": "tally",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:dev": "nodemon --ext js,ts,json,env --exec 'tsx --tsconfig ./tsconfig.json' src/Bootstrap/Fastify/application.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles",
    "test:units": "yarn test --passWithNoTests --testPathIgnorePatterns=e2e.spec.ts",
    "test:e2e": "yarn test --passWithNoTests --testPathPatterns=e2e.spec.ts",
    "lint": "eslint .",
    "format": "prettier \"./**\" --write --ignore-unknown",
    "format:check": "prettier \"./**\" --ignore-unknown --check",
    "check:conventions": "clean-ddd check",
    "conventions:write": "clean-ddd check --write",
    "architecture": "clean-ddd"
  },
  "dependencies": {
    "@fastify/cors": "^11",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "pg": "8",
    "tslib": "^2.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "clean-ddd": "file:vendor/clean-ddd-3.2.0.tgz",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "js-yaml": "^5.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "typescript-eslint": "^8.71.0"
  }
}
